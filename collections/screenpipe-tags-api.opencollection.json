{
  "opencollection": "1.0.0",
  "info": {
    "name": "Screenpipe Activity Tags API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get tags in batch",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/tags/vision/batch",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Batch fetch tags for multiple vision frame IDs.\nPOST /tags/vision/batch  { \"frame_ids\": [1, 2, 3] }"
        },
        {
          "info": {
            "name": "Add tags",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/tags/:content_type/:id",
            "params": [
              {
                "name": "content_type",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add tags to a specific content item (frame or audio chunk)."
        },
        {
          "info": {
            "name": "Remove tags",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tags/:content_type/:id",
            "params": [
              {
                "name": "content_type",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Remove tags from a specific content item."
        }
      ]
    }
  ],
  "bundled": true
}